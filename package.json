{
  "name": "chess-club-api",
  "version": "1.0.0",
  "description": "Chess Club Management API built with Next.js and Supabase",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "db:status": "supabase migration list --linked",
    "db:push": "supabase db push --linked",
    "db:push:dry-run": "supabase db push --dry-run --linked",
    "db:types": "supabase gen types typescript --linked --schema public > lib/database.types.ts",
    "migrate:ranking": "pnpm exec tsx scripts/migrate-ranking-to-supabase.ts",
    "setup:storage": "pnpm exec tsx scripts/setup-storage-buckets.ts",
    "test:email": "node scripts/test-email.js",
    "send:admin-update": "pnpm exec tsx scripts/send-admin-update.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@mliebelt/pgn-parser": "^1.4.19",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vercel/analytics": "^2.0.1",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@tailwindcss/typography>postcss-selector-parser": "^7.1.7",
      "minimatch@>=10.0.0 <11.0.1": "^11.0.3"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
