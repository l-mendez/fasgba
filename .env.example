# Supabase (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_ or add to next.config env.
SUPABASE_SECRET_KEY=sb_secret_...

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: API base URL for client fetches (defaults to window.location.origin)
NEXT_PUBLIC_BASE_URL=

# Email (Zoho SMTP password for the no-reply account)
NO_REPLY_PASSWORD=

# Vercel cron auth (any long random string; set the same value in Vercel)
CRON_SECRET=

# Optional: `pnpm shot <path> --auth` signs in as this user to screenshot admin pages.
# Use a dedicated dev account (with the roles you need to see), never a real admin's password.
SHOT_EMAIL=
SHOT_PASSWORD=

# SEO: Search Console / Bing Webmaster meta-tag verification tokens (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
